NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Leave blank in production (and when using `vercel dev`) — frontend and
# backend share one domain under Vercel Services, so calls are relative to
# /api/backend automatically. Only set this for local dev if you're running
# the backend as its own process on another port, e.g. http://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_OWNER_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
