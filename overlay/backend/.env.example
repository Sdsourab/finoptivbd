SUPABASE_URL=
# Preferred current server-only API key (sb_secret_...). Never expose this in the frontend.
SUPABASE_SECRET_KEY=
# Legacy fallback for existing projects; deprecated by Supabase at the end of 2026.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed for projects still using legacy HS256 JWT signing.
SUPABASE_JWT_SECRET=
# Only needed when the backend is run separately from the frontend locally.
ALLOWED_ORIGINS=http://localhost:3000
