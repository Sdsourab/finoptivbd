NEXT_PUBLIC_SUPABASE_URL=
# Preferred current browser-safe key (sb_publishable_...). Never put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for existing projects; deprecated by Supabase at the end of 2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Leave blank in production: Vercel Services routes frontend/backend on the same domain.
# Only set this for local dev when FastAPI runs separately, e.g. http://localhost:8000
NEXT_PUBLIC_API_URL=
# Required to enable the Hire Me contact buttons.
NEXT_PUBLIC_OWNER_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# Optional. Vercel's VERCEL_PROJECT_PRODUCTION_URL is used as an automatic fallback.
NEXT_PUBLIC_SITE_URL=
